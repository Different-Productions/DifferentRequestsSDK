    },
    "That didn't send. We kept what you wrote, so tap Send to try again." : {
      "comment" : "A new request failed to send; Send is the button's name",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يُرسَل. احتفظنا بما كتبت، فاضغط «إرسال» للمحاولة مجددًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das wurde nicht gesendet. Dein Text ist noch da, tippe auf „Senden“, um es erneut zu versuchen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se envió. Guardamos lo que escribiste; toca Enviar para intentarlo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'envoi a échoué. Nous avons gardé votre texte : touchez Envoyer pour réessayer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato inviato. Abbiamo tenuto quello che hai scritto: tocca Invia per riprovare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "送信できませんでした。書いた内容は残っているので、「送信」をタップしてもう一度お試しください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie wysłano. Zachowaliśmy to, co napisałeś — dotknij „Wyślij”, aby spróbować ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi enviado. Guardamos o que você escreveu; toque em Enviar para tentar de novo."
          }
        }
      }
    },
    "That notification is gone." : {
      "comment" : "Marking read a notification that no longer exists",
