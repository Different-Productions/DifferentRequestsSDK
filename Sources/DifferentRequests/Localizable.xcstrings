        }
      }
    },
    "Your comment didn't send. We kept what you wrote, so tap Send to try again." : {
      "comment" : "A comment failed to send; Send is the button's name",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يُرسَل تعليقك. احتفظنا بما كتبت، فاضغط «إرسال» للمحاولة مجددًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Kommentar wurde nicht gesendet. Dein Text ist noch da, tippe auf „Senden“, um es erneut zu versuchen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
