      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر تعليمه كمقروء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das konnte nicht als gelesen markiert werden."
