    "This update couldn't be marked as read. Open Inbox again to refresh it." : {
      "comment" : "The server refused marking one notification read",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر تعليم هذا التحديث كمقروء. افتح صندوق الوارد مجددًا لتحديثه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Update konnte nicht als gelesen markiert werden. Öffne den Posteingang erneut, um ihn zu aktualisieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta novedad no se pudo marcar como leída. Vuelve a abrir la Bandeja de entrada para actualizarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette mise à jour n'a pas pu être marquée comme lue. Rouvrez la Boîte de réception pour l'actualiser."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato possibile segnare questo aggiornamento come letto. Riapri In arrivo per aggiornare l'elenco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このお知らせを既読にできませんでした。受信箱を開き直して更新してください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się oznaczyć tej aktualizacji jako przeczytanej. Otwórz Skrzynkę ponownie, aby ją odświeżyć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível marcar esta atualização como lida. Abra a Caixa de entrada de novo para atualizá-la."
          }
        }
      }
    },
    "Your request didn't send. What you wrote is still here. Choose Send to try again." : {
      "comment" : "A new request failed to send; Send is the button's name",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يُرسَل طلبك. ما كتبته ما زال هنا. اختر «إرسال» للمحاولة مجددًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Anfrage wurde nicht gesendet. Dein Text ist noch da. Wähle Senden, um es erneut zu versuchen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu solicitud no se envió. Lo que escribiste sigue aquí. Elige Enviar para intentarlo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre demande n'a pas été envoyée. Votre texte est toujours là. Choisissez Envoyer pour réessayer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua richiesta non è stata inviata. Quello che hai scritto è ancora qui. Scegli Invia per riprovare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リクエストを送信できませんでした。書いた内容は残っています。「送信」を選んでもう一度お試しください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoja prośba nie została wysłana. Twój tekst nadal tu jest. Wybierz Wyślij, aby spróbować ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu pedido não foi enviado. O que você escreveu continua aqui. Escolha Enviar para tentar de novo."
          }
        }
      }
    },
    "This update was removed." : {
