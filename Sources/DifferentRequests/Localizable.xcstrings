        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Tes demandes vont à l'équipe derrière %@.** Nous ne vendons ni ne partageons ce que tu écris."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Le tue richieste vanno al team dietro %@.** Non vendiamo né condividiamo ciò che scrivi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**リクエストは %@ のチームに届きます。**書いた内容を販売したり共有したりすることはありません。"
