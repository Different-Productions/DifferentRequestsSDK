    "If a request already says this, vote for it instead, so the votes stay in one place." : {
      "comment" : "Warning above the new request form after a search",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إن كان هناك طلب يقول هذا، فصوّت له بدلًا من ذلك لتبقى الأصوات في مكان واحد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn eine Anfrage das schon sagt, stimm lieber für sie ab, damit die Stimmen an einem Ort bleiben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si ya hay una solicitud que dice esto, vótala en su lugar para que los votos queden juntos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si une demande dit déjà cela, votez plutôt pour elle, pour que les votes restent au même endroit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se una richiesta dice già questo, vota quella, così i voti restano in un solo posto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同じ内容のリクエストがあれば、そちらに投票してください。票が一か所にまとまります。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli jakaś prośba już to mówi, zagłosuj na nią, żeby głosy były w jednym miejscu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se um pedido já diz isso, vote nele, para os votos ficarem num lugar só."
          }
        }
      }
    },
