    "**Your requests go to the team behind %@.** We don't sell or share what you write." : {
      "comment" : "What is this? page; Markdown bold on the first sentence; the argument is the app's name",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**تذهب طلباتك إلى الفريق الذي يقف وراء %@.** لا نبيع ما تكتبه ولا نشاركه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Deine Anfragen gehen an das Team hinter %@.** Wir verkaufen oder teilen nicht, was du schreibst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Tus solicitudes llegan al equipo detrás de %@.** No vendemos ni compartimos lo que escribes."
