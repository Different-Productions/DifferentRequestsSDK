    "Ranked by votes and searchable, with a button to ask for something new." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مرتبة حسب الأصوات وقابلة للبحث، مع زر لطلب شيء جديد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach Stimmen sortiert und durchsuchbar, mit einer Taste für neue Wünsche."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordenadas por votos y con búsqueda, con un botón para pedir algo nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Classées par votes et consultables, avec un bouton pour demander quelque chose."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordinate per voti e ricercabili, con un pulsante per chiedere qualcosa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "投票順で検索でき、新しいリクエストのボタン付き。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Według głosów, z wyszukiwaniem i przyciskiem nowej prośby."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por votos e pesquisáveis, com um botão para pedir algo novo."
          }
        }
      }
    },
    "Status changes, replies and duplicates on what they follow. Tapping a notification opens it." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تغييرات الحالة والردود والطلبات المكررة لما يتابعونه. النقر على إشعار يفتحه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Statusänderungen, Antworten und Duplikate zu dem, was sie verfolgen. Tippen öffnet die Mitteilung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambios de estado, respuestas y duplicados de lo que siguen. Al tocar una notificación se abre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Changements de statut, réponses et doublons sur ce qu'ils suivent. Toucher une notification l'ouvre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambi di stato, risposte e duplicati su ciò che seguono. Toccare una notifica la apre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フォロー中の状態変更・返信・重複。通知をタップすると開きます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmiany statusu, odpowiedzi i duplikaty obserwowanych próśb. Stuknięcie otwiera powiadomienie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mudanças de status, respostas e duplicados do que seguem. Tocar numa notificação a abre."
          }
        }
      }
    },
    "Planned and in progress, in columns." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المخطط له وقيد التنفيذ، في أعمدة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geplant und in Arbeit, in Spalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planeado y en curso, en columnas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prévu et en cours, en colonnes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pianificato e in corso, in colonne."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "計画中と進行中を列で表示。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaplanowane i w toku, w kolumnach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planejado e em andamento, em colunas."
          }
        }
      }
    },
    "What shipped, written up, linked to the requests it answers." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ما تم إطلاقه، موصوفًا ومرتبطًا بالطلبات التي يجيب عنها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was erschienen ist, beschrieben und mit den beantworteten Anfragen verknüpft."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que se lanzó, descrito y enlazado a las solicitudes que responde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce qui est sorti, décrit et relié aux demandes auxquelles il répond."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciò che è uscito, descritto e collegato alle richieste a cui risponde."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リリース内容と、対応したリクエストへのリンク。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Co wydano, z opisem i powiązanymi prośbami."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O que foi lançado, descrito e ligado aos pedidos que atende."
          }
        }
      }
    },
    "What the SDK says about its own setup. Paste it into a support email." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ما يقوله SDK عن إعداده. الصقه في بريد الدعم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was das SDK über seine Einrichtung sagt. In eine Support-E-Mail einfügen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que el SDK dice de su configuración. Pégalo en un correo de soporte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce que le SDK dit de sa configuration. À coller dans un e-mail au support."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cosa dice l'SDK della sua configurazione. Incollalo in un'email al supporto."
