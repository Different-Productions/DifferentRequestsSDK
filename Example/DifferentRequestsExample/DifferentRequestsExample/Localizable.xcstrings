    "Couldn't load this app's settings. Check the log for the server's answer." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر تحميل إعدادات هذا التطبيق. راجع السجل لمعرفة رد الخادم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Einstellungen dieser App konnten nicht geladen werden. Die Antwort des Servers steht im Protokoll."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo cargar la configuración de esta app. Consulta el registro para ver la respuesta del servidor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de charger les réglages de cette app. Consulte le journal pour voir la réponse du serveur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile caricare le impostazioni di questa app. Controlla il log per la risposta del server."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアプリの設定を読み込めませんでした。サーバーの応答はログで確認してください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się wczytać ustawień tej aplikacji. Sprawdź w logu odpowiedź serwera."
          }
