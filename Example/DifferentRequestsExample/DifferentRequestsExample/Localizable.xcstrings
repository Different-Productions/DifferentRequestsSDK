    "Everything in this list is drawn by the SDK and presented over your app. Nothing about how it looks is written here." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كل ما في هذه القائمة يرسمه SDK ويعرضه فوق تطبيقك. لا شيء من مظهره مكتوب هنا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles in dieser Liste zeichnet das SDK über deiner App. Nichts an seinem Aussehen steht hier."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo lo de esta lista lo dibuja el SDK sobre tu app. Nada de su aspecto está escrito aquí."
