<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The macOS spelling of the iOS file's aps-environment: which APNs environment a token
	     minted for this build belongs to. It must match what DemoConfig.pushEnvironment says. -->
	<key>com.apple.developer.aps-environment</key>
	<string>development</string>
</dict>
</plist>
